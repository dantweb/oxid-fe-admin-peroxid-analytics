{
  "name": "@dantweb/oxid-fe-admin-peroxid-analytics",
  "version": "0.1.0",
  "description": "Analytics plugin for oxid-fe-admin: sales and customer curves (daily, weekly, per customer, log scale) over a demo data set generated in the browser.",
  "license": "MIT",
  "type": "module",
  "repository": "github:dantweb/oxid-fe-admin-peroxid-analytics",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "21.0.4",
    "knip": "^6.41.0",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  }
}
